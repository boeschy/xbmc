From da2caa075bb51229001251dbab054fba46b9fac2 Mon Sep 17 00:00:00 2001
From: Johan Vos <jvos@openjdk.org>
Date: Fri, 20 Sep 2024 10:02:55 +0000
Subject: [PATCH] 8340467: [mobile] duplicate symbols in libprefs.a on iOS

Reviewed-by: dholmes, jpereda
---
 make/modules/java.prefs/Lib.gmk | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/make/modules/java.prefs/Lib.gmk b/make/modules/java.prefs/Lib.gmk
index 033768ffa1d..25ac6c0b0cb 100644
--- a/make/modules/java.prefs/Lib.gmk
+++ b/make/modules/java.prefs/Lib.gmk
@@ -28,7 +28,7 @@ include LibCommon.gmk
 ################################################################################

 # libprefs on macosx do not use the unix code
-ifeq ($(call isTargetOs, macosx), true)
+ifeq ($(call isTargetOs, macosx ios), true)
   LIBPREFS_EXCLUDE_SRC_PATTERNS := unix
 endif
 
